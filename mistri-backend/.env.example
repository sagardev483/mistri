# mistri-backend/.env.example

# --- Core ---
SECRET_KEY=changeme-generate-a-real-one-for-each-environment
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (dev/test — read directly by config/settings/base.py) ---
DB_NAME=mistri_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Database (production only — Railway provides this as one string,
# read by config/settings/production.py; DB_* above are ignored when this is set) ---
DATABASE_URL=postgres://user:password@host:port/dbname

# --- Production-only hardening (config/settings/production.py) ---
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# --- E2E test DB override (optional — defaults to mistri_e2e) ---
E2E_DB_NAME=mistri_e2e